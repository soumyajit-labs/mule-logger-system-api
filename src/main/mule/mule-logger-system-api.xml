			</ee:message>
		</ee:transform>
		<logger level="DEBUG" doc:name="DEBUG - Response logger" doc:id="e228f351-e8e6-4a2c-b349-67e1094c6914" message="Response Payload : #[payload default []]" category="com.galactica.logger" />
		<logger level="INFO" doc:name="INFO - Ending Logger" doc:id="7f3d689e-fd7e-4b41-a650-00437f3a293b" message='#["This is the ending INFO logger for GET:/contacts flow."]' category="com.galactica.logger" />
    </flow>
</mule>
